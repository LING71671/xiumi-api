# 统一行尾，避免跨平台 diff 噪音
* text=auto eol=lf

# 生成的 CSV 带 BOM（Excel 打开中文不乱码），保持字节原样
*.csv -text

# 二进制资源不做任何转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.bmp   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.pdf   binary

# 文本类显式声明，便于 GitHub 语言统计
*.mjs  text
*.js   text
*.py   text
*.md   text
*.json text
*.yml  text
*.yaml text
